generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  AREA_SALES_MANAGER
  SALES_REP
  DISTRIBUTOR
  RETAILER
  PROMOTER
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum VisitStatus {
  CHECKED_IN
  COMPLETED
  NO_ORDER
  SKIPPED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  ONBOARDED
  LOST
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  CURRENCY
  CHECKBOX
  SELECT
  DEPENDENT_SELECT
  LOOKUP
  EMAIL
  PHONE
  GEOLOCATION
}

enum ModuleName {
  ADDRESS
  CLIENT
  EMPLOYEE
  PRODUCT
  SCHEME
  TARGET
  SLA
  ORDER
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(SALES_REP)
  isActive     Boolean   @default(true)
  customFields Json?     @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  distributor  Distributor?
  beats        Beat[]        @relation("RepBeats")
  visits       Visit[]
  orders       Order[]       @relation("RepOrders")
  employee     Employee?
}

model Employee {
  id                  String            @id @default(uuid())
  empCode             String            @unique
  name                String
  email               String            @unique
  phone               String
  designation         String            // Area Sales Manager, Sales Representative, Zonal Head, Regional Director
  department          String            @default("Field Sales")
  status              String            @default("ACTIVE") // ACTIVE, INACTIVE, ON_LEAVE, VACANT
  vacantPositionTitle String?
  vacatedAt           DateTime?
  effectiveStartDate  DateTime          @default(now())
  effectiveEndDate    DateTime?
  territoryId         String?
  territoryName       String?
  managerId           String?
  manager             Employee?         @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  directReports       Employee[]        @relation("EmployeeHierarchy")
  userId              String?           @unique
  user                User?             @relation(fields: [userId], references: [id])
  permissions         Json?             @default("{\"canView\":true,\"canCreate\":true,\"canEdit\":true,\"canDelete\":false,\"canImport\":false,\"canExport\":true,\"canAssign\":false,\"canTransfer\":false,\"isSuperAdmin\":false}")
  customFields        Json?             @default("{}")
  delegationsGiven    DelegatedAccess[] @relation("DelegationsGiven")
  delegationsReceived DelegatedAccess[] @relation("DelegationsReceived")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([managerId])
  @@index([status])
  @@index([department])
}

model DelegatedAccess {
  id             String    @id @default(uuid())
  fromEmployeeId String
  fromEmployee   Employee  @relation("DelegationsGiven", fields: [fromEmployeeId], references: [id], onDelete: Cascade)
  toEmployeeId   String
  toEmployee     Employee  @relation("DelegationsReceived", fields: [toEmployeeId], references: [id], onDelete: Cascade)
  scope          String    @default("ALL") // ALL, OUT_OF_HIERARCHY, READ_ONLY
  effectiveStart DateTime  @default(now())
  effectiveEnd   DateTime
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  reason         String?
  createdAt      DateTime  @default(now())

  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@index([status])
}

model Territory {
  id           String        @id @default(uuid())
  name         String
  zone         String        // North, South, East, West
  state        String
  city         String
  distributors Distributor[]
  beats        Beat[]
  createdAt    DateTime      @default(now())
}

model Address {
  id           String   @id @default(uuid())
  addressLine1 String
  addressLine2 String?
  country      String   @default("India")
  state        String
  city         String
  district     String?
  zone         String?  // North, South, East, West, Central
  territory    String?
  townLocality String?
  pincode      String
  route        String?
  beat         String?
  deliveryArea String?
  lat          Float?
  lng          Float?
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  customFields Json?    @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([country, state, city])
  @@index([pincode])
  @@index([status])
}

model Distributor {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  contactPerson String
  phone        String
  email        String?
  gstin        String?
  address      String
  territoryId  String
  territory    Territory  @relation(fields: [territoryId], references: [id])
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id])
  retailers    Retailer[]
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Beat {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  dayOfWeek    String     // e.g. "Monday", "Tuesday"
  territoryId  String
  territory    Territory  @relation(fields: [territoryId], references: [id])
  assignedToId String?
  assignedTo   User?      @relation("RepBeats", fields: [assignedToId], references: [id])
  retailers    Retailer[]
  visits       Visit[]
  createdAt    DateTime   @default(now())
}

model Retailer {
  id            String       @id @default(uuid())
  storeName     String
  ownerName     String
  phone         String
  email         String?
  address       String
  gstin         String?
  lat           Float?
  lng           Float?
  beatId        String
  beat          Beat         @relation(fields: [beatId], references: [id])
  distributorId String
  distributor   Distributor  @relation(fields: [distributorId], references: [id])
  customFields  Json?        @default("{}")
  visits        Visit[]
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id               String      @id @default(uuid())
  name             String
  sku              String      @unique
  barcode          String?     @unique
  hsnCode          String?
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  uom              String      @default("PCS") // Unit of measure (PCS, BOX, CASE, KG)
  mrp              Float
  distributorPrice Float
  retailerPrice    Float
  gstRate          Float       @default(18.0) // 5%, 12%, 18%, etc.
  stockQuantity    Int         @default(100)
  imageUrl         String?
  isActive         Boolean     @default(true)
  customFields     Json?       @default("{}")
  orderItems       OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Visit {
  id            String      @id @default(uuid())
  repId         String
  rep           User        @relation(fields: [repId], references: [id])
  retailerId    String
  retailer      Retailer    @relation(fields: [retailerId], references: [id])
  beatId        String
  beat          Beat        @relation(fields: [beatId], references: [id])
  checkIn       DateTime    @default(now())
  checkOut      DateTime?
  lat           Float?
  lng           Float?
  status        VisitStatus @default(CHECKED_IN)
  noOrderReason String?
  notes         String?
  orders        Order[]
  createdAt     DateTime    @default(now())
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  repId         String
  rep           User          @relation("RepOrders", fields: [repId], references: [id])
  retailerId    String
  retailer      Retailer      @relation(fields: [retailerId], references: [id])
  distributorId String
  distributor   Distributor   @relation(fields: [distributorId], references: [id])
  visitId       String?
  visit         Visit?        @relation(fields: [visitId], references: [id])
  subTotal      Float
  discount      Float         @default(0.0)
  taxAmount     Float         @default(0.0)
  totalAmount   Float
  status        OrderStatus   @default(SUBMITTED)
  paymentStatus PaymentStatus @default(PENDING)
  notes         String?
  customFields  Json?         @default("{}")
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  freeQty     Int      @default(0)
  discount    Float    @default(0.0)
}

model Scheme {
  id              String   @id @default(uuid())
  title           String
  code            String   @unique
  description     String?
  type            String   // PERCENTAGE_DISCOUNT, FLAT_DISCOUNT, BOGO
  minOrderQty     Int      @default(1)
  discountPercent Float?   @default(0.0)
  flatDiscount    Float?   @default(0.0)
  freeSkuCode     String?
  freeSkuQty      Int?     @default(0)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  customFields    Json?    @default("{}")
  createdAt       DateTime @default(now())
}

model Lead {
  id           String    @id @default(uuid())
  businessName String
  contactName  String
  phone        String
  email        String?
  address      String?
  leadType     String    // DISTRIBUTOR, DEALER, RETAILER
  stage        LeadStage @default(NEW)
  expectedVal  Float?    @default(0.0)
  notes        String?
  nextFollowUp DateTime?
  customFields Json?     @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PosTransaction {
  id            String   @id @default(uuid())
  billNumber    String   @unique
  customerName  String?
  customerPhone String?
  paymentMethod String   // CASH, UPI, CARD
  subTotal      Float
  taxAmount     Float    @default(0.0)
  totalAmount   Float
  itemsJson     String   // Serialized line items
  notes         String?
  createdAt     DateTime @default(now())
}

model PromoterLog {
  id            String   @id @default(uuid())
  promoterName  String
  storeName     String
  date          DateTime @default(now())
  walkIns       Int      @default(0)
  interactions  Int      @default(0)
  salesUnits    Int      @default(0)
  salesValue    Float    @default(0.0)
  feedback      String?
  createdAt     DateTime @default(now())
}

model FieldDefinition {
  id            String          @id @default(uuid())
  module        ModuleName
  name          String          // Internal programmatic key e.g. "cert_num"
  label         String          // User-facing label e.g. "Certificate Number"
  dataType      CustomFieldType @default(TEXT)
  placeholder   String?
  defaultValue  String?
  isRequired    Boolean         @default(false)
  isUnique      Boolean         @default(false)
  minVal        Float?
  maxVal        Float?
  regexPattern  String?
  regexErrorMsg String?
  optionsJson   String?         // Options for dropdown/dependent dropdown as JSON string
  dependentOnId String?         // Parent FieldDefinition id
  lookupTarget  String?         // Target lookup master/table
  sortOrder     Int             @default(0)
  isActive      Boolean         @default(true)
  showInList    Boolean         @default(true)
  showInDetail  Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([module, name])
  @@index([module, isActive])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   // e.g. "FIELD_DEFINITION", "CLIENT", "ADDRESS", "PRODUCT"
  entityId   String
  action     String   // "CREATE", "UPDATE", "DELETE", "CONVERT", "DEACTIVATE"
  actorEmail String   @default("admin@sassist.crm")
  actorName  String   @default("System Admin")
  oldValues  Json?
  newValues  Json?
  reason     String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
}

