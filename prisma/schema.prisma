generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  AREA_SALES_MANAGER
  SALES_REP
  DISTRIBUTOR
  RETAILER
  PROMOTER
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum VisitStatus {
  CHECKED_IN
  COMPLETED
  NO_ORDER
  SKIPPED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  ONBOARDED
  LOST
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(SALES_REP)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  distributor  Distributor?
  beats        Beat[]        @relation("RepBeats")
  visits       Visit[]
  orders       Order[]       @relation("RepOrders")
}

model Territory {
  id           String        @id @default(uuid())
  name         String
  zone         String        // North, South, East, West
  state        String
  city         String
  distributors Distributor[]
  beats        Beat[]
  createdAt    DateTime      @default(now())
}

model Distributor {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  contactPerson String
  phone        String
  email        String?
  gstin        String?
  address      String
  territoryId  String
  territory    Territory  @relation(fields: [territoryId], references: [id])
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id])
  retailers    Retailer[]
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Beat {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  dayOfWeek    String     // e.g. "Monday", "Tuesday"
  territoryId  String
  territory    Territory  @relation(fields: [territoryId], references: [id])
  assignedToId String?
  assignedTo   User?      @relation("RepBeats", fields: [assignedToId], references: [id])
  retailers    Retailer[]
  visits       Visit[]
  createdAt    DateTime   @default(now())
}

model Retailer {
  id            String       @id @default(uuid())
  storeName     String
  ownerName     String
  phone         String
  email         String?
  address       String
  gstin         String?
  lat           Float?
  lng           Float?
  beatId        String
  beat          Beat         @relation(fields: [beatId], references: [id])
  distributorId String
  distributor   Distributor  @relation(fields: [distributorId], references: [id])
  visits        Visit[]
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id               String      @id @default(uuid())
  name             String
  sku              String      @unique
  barcode          String?     @unique
  hsnCode          String?
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  uom              String      @default("PCS") // Unit of measure (PCS, BOX, CASE, KG)
  mrp              Float
  distributorPrice Float
  retailerPrice    Float
  gstRate          Float       @default(18.0) // 5%, 12%, 18%, etc.
  stockQuantity    Int         @default(100)
  imageUrl         String?
  isActive         Boolean     @default(true)
  orderItems       OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Visit {
  id            String      @id @default(uuid())
  repId         String
  rep           User        @relation(fields: [repId], references: [id])
  retailerId    String
  retailer      Retailer    @relation(fields: [retailerId], references: [id])
  beatId        String
  beat          Beat        @relation(fields: [beatId], references: [id])
  checkIn       DateTime    @default(now())
  checkOut      DateTime?
  lat           Float?
  lng           Float?
  status        VisitStatus @default(CHECKED_IN)
  noOrderReason String?
  notes         String?
  orders        Order[]
  createdAt     DateTime    @default(now())
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  repId         String
  rep           User          @relation("RepOrders", fields: [repId], references: [id])
  retailerId    String
  retailer      Retailer      @relation(fields: [retailerId], references: [id])
  distributorId String
  distributor   Distributor   @relation(fields: [distributorId], references: [id])
  visitId       String?
  visit         Visit?        @relation(fields: [visitId], references: [id])
  subTotal      Float
  discount      Float         @default(0.0)
  taxAmount     Float         @default(0.0)
  totalAmount   Float
  status        OrderStatus   @default(SUBMITTED)
  paymentStatus PaymentStatus @default(PENDING)
  notes         String?
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  freeQty     Int      @default(0)
  discount    Float    @default(0.0)
}

model Scheme {
  id              String   @id @default(uuid())
  title           String
  code            String   @unique
  description     String?
  type            String   // PERCENTAGE_DISCOUNT, FLAT_DISCOUNT, BOGO
  minOrderQty     Int      @default(1)
  discountPercent Float?   @default(0.0)
  flatDiscount    Float?   @default(0.0)
  freeSkuCode     String?
  freeSkuQty      Int?     @default(0)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Lead {
  id           String    @id @default(uuid())
  businessName String
  contactName  String
  phone        String
  email        String?
  address      String?
  leadType     String    // DISTRIBUTOR, DEALER, RETAILER
  stage        LeadStage @default(NEW)
  expectedVal  Float?    @default(0.0)
  notes        String?
  nextFollowUp DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PosTransaction {
  id            String   @id @default(uuid())
  billNumber    String   @unique
  customerName  String?
  customerPhone String?
  paymentMethod String   // CASH, UPI, CARD
  subTotal      Float
  taxAmount     Float    @default(0.0)
  totalAmount   Float
  itemsJson     String   // Serialized line items
  notes         String?
  createdAt     DateTime @default(now())
}

model PromoterLog {
  id            String   @id @default(uuid())
  promoterName  String
  storeName     String
  date          DateTime @default(now())
  walkIns       Int      @default(0)
  interactions  Int      @default(0)
  salesUnits    Int      @default(0)
  salesValue    Float    @default(0.0)
  feedback      String?
  createdAt     DateTime @default(now())
}
