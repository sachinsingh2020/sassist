generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  AREA_SALES_MANAGER
  SALES_REP
  DISTRIBUTOR
  RETAILER
  PROMOTER
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum VisitStatus {
  CHECKED_IN
  COMPLETED
  NO_ORDER
  SKIPPED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  ONBOARDED
  LOST
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  CURRENCY
  CHECKBOX
  SELECT
  DEPENDENT_SELECT
  LOOKUP
  EMAIL
  PHONE
  GEOLOCATION
}

enum ModuleName {
  ADDRESS
  CLIENT
  EMPLOYEE
  PRODUCT
  SCHEME
  TARGET
  SLA
  ORDER
  AUTOMATION
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(SALES_REP)
  isActive     Boolean   @default(true)
  customFields Json?     @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  distributor  Distributor?
  beats        Beat[]        @relation("RepBeats")
  visits       Visit[]
  orders       Order[]       @relation("RepOrders")
  employee     Employee?
}

model Employee {
  id                  String            @id @default(uuid())
  empCode             String            @unique
  name                String
  email               String            @unique
  phone               String
  designation         String            // Area Sales Manager, Sales Representative, Zonal Head, Regional Director
  department          String            @default("Field Sales")
  status              String            @default("ACTIVE") // ACTIVE, INACTIVE, ON_LEAVE, VACANT
  vacantPositionTitle String?
  vacatedAt           DateTime?
  effectiveStartDate  DateTime          @default(now())
  effectiveEndDate    DateTime?
  territoryId         String?
  territoryName       String?
  managerId           String?
  manager             Employee?         @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  directReports       Employee[]        @relation("EmployeeHierarchy")
  userId              String?           @unique
  user                User?             @relation(fields: [userId], references: [id])
  permissions         Json?             @default("{\"canView\":true,\"canCreate\":true,\"canEdit\":true,\"canDelete\":false,\"canImport\":false,\"canExport\":true,\"canAssign\":false,\"canTransfer\":false,\"isSuperAdmin\":false}")
  customFields        Json?             @default("{}")
  delegationsGiven    DelegatedAccess[] @relation("DelegationsGiven")
  delegationsReceived DelegatedAccess[] @relation("DelegationsReceived")
  ownedClients        Client[]          @relation("ClientOwnership")
  clientShares        ClientShare[]
  targets             Target[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([managerId])
  @@index([status])
  @@index([department])
}

model DelegatedAccess {
  id             String    @id @default(uuid())
  fromEmployeeId String
  fromEmployee   Employee  @relation("DelegationsGiven", fields: [fromEmployeeId], references: [id], onDelete: Cascade)
  toEmployeeId   String
  toEmployee     Employee  @relation("DelegationsReceived", fields: [toEmployeeId], references: [id], onDelete: Cascade)
  scope          String    @default("ALL") // ALL, OUT_OF_HIERARCHY, READ_ONLY
  effectiveStart DateTime  @default(now())
  effectiveEnd   DateTime
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  reason         String?
  createdAt      DateTime  @default(now())

  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@index([status])
}

model Territory {
  id           String        @id @default(uuid())
  name         String
  zone         String        // North, South, East, West
  state        String
  city         String
  distributors Distributor[]
  beats        Beat[]
  targets      Target[]
  createdAt    DateTime      @default(now())
}

model Address {
  id           String   @id @default(uuid())
  addressLine1 String
  addressLine2 String?
  country      String   @default("India")
  state        String
  city         String
  district     String?
  zone         String?  // North, South, East, West, Central
  territory    String?
  townLocality String?
  pincode      String
  route        String?
  beat         String?
  deliveryArea String?
  lat          Float?
  lng          Float?
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  customFields Json?    @default("{}")
  clients      Client[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([country, state, city])
  @@index([pincode])
  @@index([status])
}

model Client {
  id            String              @id @default(uuid())
  clientCode    String              @unique
  businessName  String
  contactName   String
  phone         String
  altPhone      String?
  email         String?
  clientType    String              @default("LEAD") // LEAD, PROSPECT, CUSTOMER
  stage         String              @default("NEW") // NEW, CONTACTED, QUALIFIED, PROPOSAL, WON, LOST
  status        String              @default("ACTIVE") // ACTIVE, INACTIVE, DORMANT
  addressId     String?
  address       Address?            @relation(fields: [addressId], references: [id])
  ownerId       String?
  owner         Employee?           @relation("ClientOwnership", fields: [ownerId], references: [id])
  sharedWith    ClientShare[]
  lat           Float?
  lng           Float?
  geoAccuracy   Float?
  geoTimestamp  DateTime?
  geoSource     String?             @default("DEVICE_GPS") // DEVICE_GPS, MANUAL_PIN, IMPORT
  creditLimit   Float?              @default(0.0)
  expectedVal   Float?              @default(0.0)
  notes         String?
  customFields  Json?               @default("{}")
  typeHistory   ClientTypeHistory[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([clientType])
  @@index([status])
  @@index([phone])
  @@index([ownerId])
}

model ClientShare {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  accessLevel String   @default("READ_WRITE") // READ_ONLY, READ_WRITE, FULL
  grantedBy   String?  @default("Admin")
  createdAt   DateTime @default(now())

  @@unique([clientId, employeeId])
  @@index([employeeId])
}

model ClientTypeHistory {
  id                   String   @id @default(uuid())
  clientId             String
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromType             String
  toType               String
  triggerReason        String
  triggerTransactionId String?
  changedBy            String   @default("System")
  timestamp            DateTime @default(now())

  @@index([clientId])
  @@index([timestamp])
}


model Distributor {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  contactPerson String
  phone        String
  email        String?
  gstin        String?
  address      String
  territoryId  String
  territory    Territory  @relation(fields: [territoryId], references: [id])
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id])
  retailers    Retailer[]
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Beat {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  dayOfWeek    String     // e.g. "Monday", "Tuesday"
  territoryId  String
  territory    Territory  @relation(fields: [territoryId], references: [id])
  assignedToId String?
  assignedTo   User?      @relation("RepBeats", fields: [assignedToId], references: [id])
  retailers    Retailer[]
  visits       Visit[]
  createdAt    DateTime   @default(now())
}

model Retailer {
  id            String       @id @default(uuid())
  storeName     String
  ownerName     String
  phone         String
  email         String?
  address       String
  gstin         String?
  lat           Float?
  lng           Float?
  beatId        String
  beat          Beat         @relation(fields: [beatId], references: [id])
  distributorId String
  distributor   Distributor  @relation(fields: [distributorId], references: [id])
  customFields  Json?        @default("{}")
  visits        Visit[]
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id                 String                @id @default(uuid())
  name               String
  sku                String                @unique
  barcode            String?               @unique
  hsnCode            String?
  categoryId         String
  category           Category              @relation(fields: [categoryId], references: [id])
  subcategory        String?               // Namkeen, Sweets, Beverages, Personal Care, etc.
  brand              String?               // e.g. TastyBites, FMCG Direct
  productType        String                @default("FINISHED_GOODS") // FINISHED_GOODS, RAW_MATERIAL, PACKAGING, PROMOTIONAL
  uom                String                @default("PCS") // Unit of measure (PCS, BOX, CASE, KG, LTR, PACK)
  basePrice          Float?                @default(0.0)
  mrp                Float
  distributorPrice   Float
  retailerPrice      Float
  gstRate            Float                 @default(18.0) // 5%, 12%, 18%, 28%
  stockQuantity      Int                   @default(100)
  minOrderQty        Int                   @default(1)
  status             String                @default("ACTIVE") // ACTIVE, INACTIVE, DISCONTINUED
  effectiveStartDate DateTime?             @default(now())
  effectiveEndDate   DateTime?
  imageUrl           String?
  isActive           Boolean               @default(true)
  customFields       Json?                 @default("{}")
  orderItems         OrderItem[]
  priceHistory       ProductPriceHistory[]
  targets            Target[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([categoryId])
  @@index([brand])
  @@index([status])
  @@index([productType])
}

model ProductPriceHistory {
  id                  String   @id @default(uuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldMrp              Float
  newMrp              Float
  oldDistributorPrice Float
  newDistributorPrice Float
  oldRetailerPrice    Float
  newRetailerPrice    Float
  effectiveDate       DateTime @default(now())
  reason              String?
  changedBy           String   @default("System Admin")
  createdAt           DateTime @default(now())

  @@index([productId])
  @@index([effectiveDate])
}

model Visit {
  id            String      @id @default(uuid())
  repId         String
  rep           User        @relation(fields: [repId], references: [id])
  retailerId    String
  retailer      Retailer    @relation(fields: [retailerId], references: [id])
  beatId        String
  beat          Beat        @relation(fields: [beatId], references: [id])
  checkIn       DateTime    @default(now())
  checkOut      DateTime?
  lat           Float?
  lng           Float?
  status        VisitStatus @default(CHECKED_IN)
  noOrderReason String?
  notes         String?
  orders        Order[]
  createdAt     DateTime    @default(now())
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  repId         String
  rep           User          @relation("RepOrders", fields: [repId], references: [id])
  retailerId    String
  retailer      Retailer      @relation(fields: [retailerId], references: [id])
  distributorId String
  distributor   Distributor   @relation(fields: [distributorId], references: [id])
  visitId       String?
  visit         Visit?        @relation(fields: [visitId], references: [id])
  subTotal      Float
  discount      Float         @default(0.0)
  taxAmount     Float         @default(0.0)
  totalAmount   Float
  status        OrderStatus   @default(SUBMITTED)
  paymentStatus PaymentStatus @default(PENDING)
  notes         String?
  customFields  Json?         @default("{}")
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  freeQty     Int      @default(0)
  discount    Float    @default(0.0)
}

model Scheme {
  id                      String                 @id @default(uuid())
  title                   String
  code                    String                 @unique
  description             String?
  type                    String                 // PERCENTAGE_DISCOUNT, FLAT_DISCOUNT, BOGO, TIERED_SLAB
  eligibleClientTypesJson String?                @default("[\"ALL\"]") // ["ALL"] or ["LEAD", "PROSPECT", "CUSTOMER"]
  eligibleProductIdsJson  String?                @default("[\"ALL\"]") // ["ALL"] or ["prod-id-1", "prod-id-2"]
  minOrderQty             Int                    @default(1)
  minOrderValue           Float?                 @default(0.0)
  discountPercent         Float?                 @default(0.0)
  flatDiscount            Float?                 @default(0.0)
  freeSkuCode             String?
  freeSkuQty              Int?                   @default(0)
  slabTiersJson           String?                // e.g. [{"minQty": 10, "discountPercent": 5}, {"minQty": 50, "discountPercent": 10}]
  maxDiscountCap          Float?
  startDate               DateTime
  endDate                 DateTime
  status                  String                 @default("ACTIVE") // ACTIVE, INACTIVE, EXPIRED
  approvalStatus          String                 @default("APPROVED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  isActive                Boolean                @default(true)
  customFields            Json?                  @default("{}")
  applicationLogs         SchemeApplicationLog[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @default(now()) @updatedAt

  @@index([status])
  @@index([approvalStatus])
  @@index([startDate, endDate])
}

model SchemeApplicationLog {
  id             String   @id @default(uuid())
  schemeId       String
  scheme         Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  orderId        String?
  clientId       String?
  orderNumber    String?
  discountAmount Float    @default(0.0)
  freeSkuCode    String?
  freeSkuQty     Int?     @default(0)
  orderSubtotal  Float    @default(0.0)
  appliedAt      DateTime @default(now())

  @@index([schemeId])
  @@index([appliedAt])
}

model Lead {
  id           String    @id @default(uuid())
  businessName String
  contactName  String
  phone        String
  email        String?
  address      String?
  leadType     String    // DISTRIBUTOR, DEALER, RETAILER
  stage        LeadStage @default(NEW)
  expectedVal  Float?    @default(0.0)
  notes        String?
  nextFollowUp DateTime?
  customFields Json?     @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PosTransaction {
  id            String   @id @default(uuid())
  billNumber    String   @unique
  customerName  String?
  customerPhone String?
  paymentMethod String   // CASH, UPI, CARD
  subTotal      Float
  taxAmount     Float    @default(0.0)
  totalAmount   Float
  itemsJson     String   // Serialized line items
  notes         String?
  createdAt     DateTime @default(now())
}

model PromoterLog {
  id            String   @id @default(uuid())
  promoterName  String
  storeName     String
  date          DateTime @default(now())
  walkIns       Int      @default(0)
  interactions  Int      @default(0)
  salesUnits    Int      @default(0)
  salesValue    Float    @default(0.0)
  feedback      String?
  createdAt     DateTime @default(now())
}

model FieldDefinition {
  id            String          @id @default(uuid())
  module        ModuleName
  name          String          // Internal programmatic key e.g. "cert_num"
  label         String          // User-facing label e.g. "Certificate Number"
  dataType      CustomFieldType @default(TEXT)
  placeholder   String?
  defaultValue  String?
  isRequired    Boolean         @default(false)
  isUnique      Boolean         @default(false)
  minVal        Float?
  maxVal        Float?
  regexPattern  String?
  regexErrorMsg String?
  optionsJson   String?         // Options for dropdown/dependent dropdown as JSON string
  dependentOnId String?         // Parent FieldDefinition id
  lookupTarget  String?         // Target lookup master/table
  sortOrder     Int             @default(0)
  isActive      Boolean         @default(true)
  showInList    Boolean         @default(true)
  showInDetail  Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([module, name])
  @@index([module, isActive])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   // e.g. "FIELD_DEFINITION", "CLIENT", "ADDRESS", "PRODUCT"
  entityId   String
  action     String   // "CREATE", "UPDATE", "DELETE", "CONVERT", "DEACTIVATE"
  actorEmail String   @default("admin@sassist.crm")
  actorName  String   @default("System Admin")
  oldValues  Json?
  newValues  Json?
  reason     String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
}

model Target {
  id              String       @id @default(uuid())
  title           String
  targetCode      String       @unique
  description     String?
  targetPeriod    String       // DAILY, WEEKLY, MONTHLY, QUARTERLY, YEARLY
  targetMetric    String       // SALES_VALUE, SALES_VOLUME, VISITS_COUNT, NEW_CLIENTS
  dimension       String       @default("EMPLOYEE") // EMPLOYEE, TERRITORY, PRODUCT, TEAM

  // Relations
  employeeId      String?
  employee        Employee?    @relation(fields: [employeeId], references: [id])
  territoryId     String?
  territory       Territory?   @relation(fields: [territoryId], references: [id])
  productId       String?
  product         Product?     @relation(fields: [productId], references: [id])
  teamName        String?

  targetQuantity  Float?       @default(0.0)
  targetValue     Float?       @default(0.0) // ₹ value
  actualQuantity  Float?       @default(0.0)
  actualValue     Float?       @default(0.0) // calculated from sales / orders / visits
  achievementRate Float?       @default(0.0) // percentage achieved e.g. 85.5%

  startDate       DateTime
  endDate         DateTime
  status          String       @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  approvalStatus  String       @default("APPROVED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  approvedBy      String?
  approvalDate    DateTime?

  customFields    Json?        @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  @@index([targetPeriod])
  @@index([targetMetric])
  @@index([dimension])
  @@index([employeeId])
  @@index([territoryId])
  @@index([approvalStatus])
  @@index([startDate, endDate])
}

model SlaPolicy {
  id                     String            @id @default(uuid())
  name                   String
  code                   String            @unique
  description            String?
  module                 ModuleName        @default(CLIENT) // CLIENT, ORDER, VISIT, SLA
  triggerEvent           String            // RECORD_CREATED, STAGE_CHANGED, STATUS_CHANGED, ORDER_SUBMITTED
  priority               String            @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT

  responseDeadlineMins   Int               @default(60) // in minutes
  resolutionDeadlineMins Int               @default(1440) // in minutes (24 hours)

  businessCalendar       String            @default("BUSINESS_HOURS") // 24X7, BUSINESS_HOURS
  workHoursStart         String?           @default("09:00")
  workHoursEnd           String?           @default("18:00")
  workDaysJson           String?           @default("[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\"]")
  timeZone               String?           @default("Asia/Kolkata")

  assignedRole           String?           // SALES_REP, AREA_SALES_MANAGER, SUPER_ADMIN

  // Escalation Rules
  escalationLevel1Mins   Int?              @default(30) // Reminder / Level 1 escalation
  escalationLevel1Role   String?           @default("AREA_SALES_MANAGER")
  escalationLevel2Mins   Int?              @default(120) // Level 2 escalation
  escalationLevel2Role   String?           @default("SUPER_ADMIN")

  // Automation conditions
  startConditionJson     String?           @default("{\"status\": \"PENDING\"}")
  pauseConditionJson     String?           @default("{\"status\": \"ON_HOLD\"}")
  stopConditionJson      String?           @default("{\"status\": \"COMPLETED\"}")

  isActive               Boolean           @default(true)
  customFields           Json?             @default("{}")
  executions             SlaExecutionLog[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @default(now()) @updatedAt

  @@index([module])
  @@index([triggerEvent])
  @@index([priority])
  @@index([isActive])
}

model SlaExecutionLog {
  id                   String     @id @default(uuid())
  policyId             String
  policy               SlaPolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  entityType           String     // CLIENT, ORDER, VISIT
  entityId             String
  entityReference      String?    // e.g. "ORD-2026-1029", "Apex Retailers"

  startTime            DateTime   @default(now())
  responseDueAt        DateTime
  resolutionDueAt      DateTime

  respondedAt          DateTime?
  resolvedAt           DateTime?

  status               String     @default("IN_PROGRESS") // IN_PROGRESS, PAUSED, RESOLVED, BREACHED
  isResponseBreached   Boolean    @default(false)
  isResolutionBreached Boolean    @default(false)

  currentEscalationLevel Int      @default(0) // 0: None, 1: Level 1, 2: Level 2
  escalatedTo          String?
  escalatedAt          DateTime?

  elapsedMinutes       Int        @default(0)
  pausedMinutes        Int        @default(0)

  notes                String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @default(now()) @updatedAt

  @@index([policyId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([isResolutionBreached])
}

model AutomationRule {
  id               String                   @id @default(uuid())
  ruleName         String
  ruleCode         String                   @unique
  description      String?
  module           ModuleName               @default(CLIENT) // CLIENT, ORDER, PRODUCT, VISIT
  triggerType      String                   // RECORD_CREATED, RECORD_UPDATED, FIELD_CHANGED, STATUS_CHANGED, SCHEDULED_TIME
  triggerField     String?                  // e.g. "status", "stage", "totalAmount"
  conditionsJson   String                   @default("[]") // [{ "field": "clientType", "operator": "EQUALS", "value": "LEAD" }]
  actionType       String                   // CLIENT_TYPE_CONVERSION, FIELD_UPDATE, OWNERSHIP_CHANGE, NOTIFICATION, SLA_TRIGGER
  actionConfigJson String                   @default("{}") // e.g. { "toType": "CUSTOMER", "reason": "First order booked" }
  executionTiming  String                   @default("IMMEDIATE") // IMMEDIATE, SCHEDULED
  effectiveDate    DateTime?                @default(now())
  effectiveTime    String?                  @default("00:00")
  timeZone         String?                  @default("Asia/Kolkata")
  recurrence       String?                  @default("ONCE") // ONCE, DAILY, WEEKLY, MONTHLY
  requiresApproval Boolean                  @default(false)
  approvalStatus   String                   @default("APPROVED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  failurePolicy    String                   @default("CONTINUE") // STOP_ON_FAILURE, CONTINUE
  status           String                   @default("ACTIVE") // ACTIVE, INACTIVE, PAUSED
  isActive         Boolean                  @default(true)
  executionCount   Int                      @default(0)
  lastExecutedAt   DateTime?
  customFields     Json?                    @default("{}")
  executionLogs    AutomationExecutionLog[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now()) @updatedAt

  @@index([module])
  @@index([triggerType])
  @@index([actionType])
  @@index([status])
  @@index([isActive])
}

model AutomationExecutionLog {
  id              String         @id @default(uuid())
  ruleId          String
  rule            AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entityType      String         // CLIENT, ORDER, etc.
  entityId        String
  entityReference String?        // e.g. "Apex Retailers", "ORD-2026-102"
  triggerEvent    String
  executionStatus String         // SUCCESS, FAILED, RETRIED, SKIPPED
  actionTaken     String         // e.g. "Converted Client from LEAD to CUSTOMER"
  beforeSnapshot  Json?
  afterSnapshot   Json?
  errorMessage    String?
  retryCount      Int            @default(0)
  executedAt      DateTime       @default(now())

  @@index([ruleId])
  @@index([entityType, entityId])
  @@index([executionStatus])
  @@index([executedAt])
}

